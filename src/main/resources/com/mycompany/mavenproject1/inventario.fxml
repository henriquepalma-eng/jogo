<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.mavenproject1.controller.InventarioController"
            prefHeight="480.0" prefWidth="650.0" styleClass="root">
    
    <top>
        <VBox spacing="6.0" styleClass="card-pane">
            <BorderPane.margin>
                <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
            <children>
                <Label text="📦 Despensa e Inventário do Chef" styleClass="titulo-principal" style="-fx-font-size: 22px;" />
                <Label text="Janela independente (Stage Separado) - Gerencie seus itens e consumíveis." styleClass="subtitulo" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <BorderPane.margin>
                <Insets bottom="10.0" left="15.0" right="15.0" />
            </BorderPane.margin>
            <children>
                <TableView fx:id="tabelaInventario" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNome" text="Item" prefWidth="170.0" />
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110.0" />
                        <TableColumn fx:id="colQuantidade" text="Qtd." prefWidth="70.0" />
                        <TableColumn fx:id="colDescricao" text="Efeito / Descrição" prefWidth="250.0" />
                    </columns>
                </TableView>
                <Label fx:id="lblStatusInventario" text="Selecione um item para utilizar durante a rodada."
                       style="-fx-text-fill: #eccc68; -fx-font-weight: bold;" />
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </BorderPane.margin>
            <children>
                <Button fx:id="btnUsarItem" text="✨ Usar Consumível" onAction="#usarItemSelecionado" styleClass="btn-sucesso" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="❌ Fechar Janela" onAction="#fecharJanela" style="-fx-background-color: #57606f;" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
