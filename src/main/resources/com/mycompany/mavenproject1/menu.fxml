<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.mavenproject1.controller.MenuController"
            prefHeight="700.0" prefWidth="980.0" styleClass="bg-menu">
    
    <!-- Topo com Status do Jogador e Imagens de Moeda/Estrela -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="card-pane">
            <BorderPane.margin>
                <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
            </BorderPane.margin>
            <children>
                <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/chef.png" />
                    </image>
                </ImageView>
                <Label text="Chef:" styleClass="label-destaque" />
                <Label fx:id="lblNomeChef" text="Chef Henrique" styleClass="label-destaque" style="-fx-text-fill: #eccc68; -fx-font-size: 16px;" />
                <Label fx:id="lblNivel" text="Nível 1" style="-fx-text-fill: #a4b0be; -fx-font-weight: bold;" />
                
                <Region HBox.hgrow="ALWAYS" />
                
                <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/moeda.png" />
                    </image>
                </ImageView>
                <Label text="Moedas:" styleClass="label-destaque" />
                <Label fx:id="lblMoedas" text="50" styleClass="label-moedas" />

                <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/estrela.png" />
                    </image>
                </ImageView>
                <Label text="Reputação:" styleClass="label-destaque" />
                <Label fx:id="lblReputacao" text="0" styleClass="label-reputacao" />
            </children>
        </HBox>
    </top>

    <!-- Centro: Logo Oficial e Menu Principal de Botões -->
    <center>
        <VBox alignment="CENTER" spacing="10.0" maxWidth="500.0" styleClass="card-menu-center">
            <BorderPane.margin>
                <Insets bottom="10.0" top="5.0" />
            </BorderPane.margin>
            <children>
                <!-- Logo do Jogo em Pixel Art -->
                <ImageView fitHeight="90.0" fitWidth="380.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/logo.png" />
                    </image>
                </ImageView>
                <Label text="Desafio Gastronômico e Gestão de Restaurante" styleClass="subtitulo" />

                <!-- Configuração rápida do Nome do Chef -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 5 0 5 0;">
                    <children>
                        <TextField fx:id="txtNomeChef" promptText="Digite seu nome de Chef..." prefWidth="250.0"
                                   style="-fx-background-color: #2f3542; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 7px;" />
                        <Button text="Alterar" onAction="#alterarNomeChef" styleClass="btn-info" />
                    </children>
                </HBox>

                <!-- Botões de Navegação -->
                <Button text="▶ Iniciar Turno (Jogar)" onAction="#abrirGameplay"
                        prefWidth="380.0" prefHeight="44.0" styleClass="btn-primario" />

                <Button text="🔨 Melhorias do Restaurante (Upgrades)" onAction="#abrirUpgrades"
                        prefWidth="380.0" prefHeight="38.0" styleClass="btn-sucesso" />

                <Button text="🛒 Loja de Ingredientes e Utensílios" onAction="#abrirLoja"
                        prefWidth="380.0" prefHeight="38.0" styleClass="btn-alerta" />

                <Button text="📦 Despensa e Inventário (Janela Separada)" onAction="#abrirInventario"
                        prefWidth="380.0" prefHeight="38.0" styleClass="btn-info" />

                <Button fx:id="btnBoss" text="🔒 Boss: O Crítico Gastronômico" onAction="#abrirBoss"
                        prefWidth="380.0" prefHeight="38.0" />

                <Button text="🏆 Ranking de Chefs" onAction="#abrirRanking"
                        prefWidth="380.0" prefHeight="38.0" />

                <Button text="ℹ️ Créditos" onAction="#abrirCreditos"
                        prefWidth="380.0" prefHeight="38.0" />

                <Button text="❌ Encerrar Jogo" onAction="#encerrarJogo"
                        prefWidth="380.0" prefHeight="35.0" style="-fx-background-color: #3d4554;" />
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 10px;">
            <children>
                <Label text="IFMS - Tópicos em Linguagem de Programação 2 | Desenvolvido por Henrique Jara Palma"
                       style="-fx-text-fill: #f1f2f6; -fx-font-size: 12px; -fx-effect: dropshadow(one-pass-box, black, 4, 0, 0, 1);" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
